              <property name="styleSheet">
               <string notr="true"> QPushButton {
                background-color: #FF4444;  /* Rojo brillante */
                border: 2px solid #CC0000;
                border-radius: 10px;
                color: white;
                padding: 12px 24px;
                font-size: 16px;
                font-weight: bold;
                min-width: 120px;
            }
            QPushButton:hover {
                background-color: #FF6666;  /* Rojo más claro al pasar el mouse */
            }
            QPushButton:pressed {
                background-color: #CC0000;  /* Rojo oscuro al presionar */
                border: 2px solid #990000;
                padding-left: 26px;  /* Desplazamiento hacia abajo/derecha */
                padding-top: 14px;
            }
            QPushButton:checked {
                background-color: #CC0000;  /* Rojo oscuro si está activado */
            }</string>
              </property>
