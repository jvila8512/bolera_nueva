     <property name="styleSheet">
      <string notr="true">QWidget#centralwidget {
   background-color: qlineargradient(spread:pad, x1:0, y1:1, x2:1, y2:0.023,
    stop:0 rgba(0, 0, 255, 255),  /* Azul */
    stop:0.5 rgba(255, 255, 255, 255),  /* Blanco */
    stop:1 rgba(0, 0, 0, 255));  /* Negro */
  
}


QFrame#frame {
	
	background-color: rgb(106, 106, 255);
    margin: 15px;
    border-radius: 20px;

    border: none;  /* Asegúrate de no tener bordes visibles  background-color: rgb(129, 129, 129);*/
}


QPushButton#pushButton {
    background-color: rgba(215, 0, 0, 210); /* Fondo rojo sólido */
    color: rgba(255, 255, 255, 210); /* Texto en blanco */
    border-radius: 10px;
}

QPushButton#pushButton:hover {
    background-color: rgba(200, 0, 0, 255); /* Rojo más oscuro para el hover */
    color: rgba(255, 255, 255, 210); /* Mantenemos el texto en blanco */
}

QPushButton#pushButton:pressed {
    background-color: rgba(150, 0, 0, 255); /* Rojo aún más oscuro para el estado presionado */
    padding-left: 5px; /* Efecto de presión */
    padding-top: 5px; /* Efecto de presión */
}


QPushButton#pushButton_2, #pushButton_3, #pushButton_4, #pushButton_5{
	background-color: rgba(0, 0, 0, 0);
	color:rgba(85, 98, 112, 255);
}

QPushButton#pushButton_2:hover, #pushButton_3:hover, #pushButton_4:hover, #pushButton_5:hover{
	color: rgba(131, 96, 53, 255);
}

QPushButton#pushButton_2:pressed, #pushButton_3:pressed, #pushButton_4:pressed, #pushButton_5:pressed{
	padding-left:5px;
	padding-top:5px;
	color:rgba(91, 88, 53, 255);
}

</string>
